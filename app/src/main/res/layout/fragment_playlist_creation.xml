<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Фиксированный Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/newPlaylist_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Toolbar.TitleText"
        app:title="@string/new_playlist"
        app:navigationIcon="@drawable/baseline_arrow_back_24"/>

    <!-- Scrollable контент: только Image + поля -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/newPlaylist_toolbar"
        app:layout_constraintBottom_toTopOf="@id/button_createPlaylist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- рамка для загрузки картинки -->
            <ImageView
                android:id="@+id/image_addPhoto"
                android:layout_width="312dp"
                android:layout_height="312dp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="26dp"
                android:src="@drawable/add_cover"
                android:clickable="true"/>

            <!-- Поле для ввода названия плейлиста -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_playlistName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="33dp"
                android:hint="@string/playlist_name"
                app:hintTextAppearance="@style/HintTextStyle"
                app:hintTextColor="@color/hint_color"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxStrokeColor="@color/input_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp"
                    android:paddingTop="18dp"
                    android:inputType="text"
                    android:textAppearance="@style/InputTextStyle"
                    android:background="@null"
                    tools:text=""/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Поле для ввода описания плейлиста -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_playlistDescription"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:hint="@string/playlist_description"
                app:hintTextAppearance="@style/HintTextStyle"
                app:hintTextColor="@color/hint_color"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxStrokeColor="@color/input_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:boxBackgroundColor="@android:color/transparent"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp"
                    android:paddingTop="18dp"
                    android:inputType="text"
                    android:textAppearance="@style/InputTextStyle"
                    android:background="@null"
                    tools:text=""/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Фиксированная кнопка внизу -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_createPlaylist"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/button_create"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textFontWeight="500"
        android:enabled="false"
        android:background="@drawable/button_create"/>
</androidx.constraintlayout.widget.ConstraintLayout>
